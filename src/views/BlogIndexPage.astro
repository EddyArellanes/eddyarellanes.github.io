---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, type Category } from '../data/site';
import type { Lang } from '../i18n/ui';
import { localizePath, otherLang, useTranslations } from '../i18n/utils';
import { getCategoryCounts, getPosts } from '../lib/blog';

interface Props {
  lang: Lang;
  /** When set, only posts in this category are listed. */
  tag?: Category;
}

const { lang, tag } = Astro.props;
const t = useTranslations(lang);
const posts = (await getPosts(lang)).filter((post) => !tag || post.data.tags.includes(tag));
const title = tag ? `${CATEGORIES[tag][lang]} · ${t('blog.title')}` : t('blog.title');
const description = tag ? `${t('blog.categoryDescription')} ${CATEGORIES[tag][lang]}.` : t('blog.description');
const alt = otherLang(lang);
// A category page only has a translation if the other language has posts in it.
const alternatePath = tag && !(await getCategoryCounts(alt)).has(tag) ? null : undefined;
---

<BaseLayout {title} {description} {lang} {alternatePath} fallbackPath={localizePath(alt, '/blog/')}>
  <h1 class="text-4xl font-bold tracking-tight">{tag ? `#${CATEGORIES[tag][lang]}` : t('blog.title')}</h1>
  <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">{description}</p>
  <CategoryFilter {lang} active={tag} />
  {
    posts.length ? (
      <div class="mt-6 divide-y divide-zinc-200 dark:divide-zinc-800">
        {posts.map((post) => <PostCard {post} {lang} />)}
      </div>
    ) : (
      <p class="mt-8 text-zinc-500">{t('blog.empty')}</p>
    )
  }
</BaseLayout>
