---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getPosts } from '../lib/blog';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<BaseLayout title={t('blog.title')} description={t('blog.description')} lang={lang}>
  <h1 class="text-4xl font-bold tracking-tight">{t('blog.title')}</h1>
  <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">{t('blog.description')}</p>
  {
    posts.length ? (
      <div class="mt-8 divide-y divide-zinc-200 dark:divide-zinc-800">
        {posts.map((post) => <PostCard post={post} lang={lang} />)}
      </div>
    ) : (
      <p class="mt-8 text-zinc-500">{t('blog.empty')}</p>
    )
  }
</BaseLayout>
