---
import { SITE } from '../data/site';
import type { Lang } from '../i18n/ui';
import { localizePath, stripLang, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const t = useTranslations(lang);
const current = stripLang(Astro.url.pathname);
const links = [
  { href: '/about/', label: t('nav.about') },
  { href: '/blog/', label: t('nav.blog') },
  { href: '/projects/', label: t('nav.projects') },
];
const isActive = (href: string) => current.startsWith(href);
---

<header class="sticky top-0 z-10 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <nav class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4">
    <a href={localizePath(lang, '/')} class="font-semibold tracking-tight hover:text-brand-500">
      {SITE.shortName}
    </a>
    <div class="flex items-center gap-5 text-sm">
      {
        links.map(({ href, label }) => (
          <a
            href={localizePath(lang, href)}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-brand-500',
              isActive(href) ? 'text-brand-500 font-medium' : 'text-zinc-600 dark:text-zinc-400',
            ]}
          >
            {label}
          </a>
        ))
      }
      <a
        href={alternatePath}
        hreflang={lang === 'en' ? 'es' : 'en'}
        title={t('lang.switch')}
        class="rounded-md border border-zinc-300 px-2 py-0.5 text-xs font-medium uppercase text-zinc-600 hover:border-brand-500 hover:text-brand-500 dark:border-zinc-700 dark:text-zinc-400"
      >
        {lang === 'en' ? 'ES' : 'EN'}
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
        class="text-zinc-600 hover:text-brand-500 dark:text-zinc-400"
      >
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
