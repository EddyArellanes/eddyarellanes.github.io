---
import { TIMELINE } from '../data/site';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<ol class="relative ml-2 border-l border-zinc-300 dark:border-zinc-700">
  {
    TIMELINE.map((item) => (
      <li class="mb-10 ml-6 last:mb-0">
        <span
          class:list={[
            'absolute -left-[7px] mt-1.5 size-3.5 rounded-full border-2 border-white dark:border-zinc-950',
            item.current ? 'bg-brand-500' : 'bg-zinc-400 dark:bg-zinc-600',
          ]}
        />
        <p class="text-sm font-medium text-brand-500">
          {item.current ? `${item.period} – ${t('present')}` : item.period}
        </p>
        <h3 class="mt-1 text-lg font-semibold">
          {item.title[lang]}
          {item.org && <span class="font-normal text-zinc-500"> @ {item.org}</span>}
        </h3>
        <p class="mt-1 text-zinc-600 dark:text-zinc-400">{item.description[lang]}</p>
      </li>
    ))
  }
</ol>
